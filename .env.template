# Copy this file to .env and fill in your values
# Never commit .env to git

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=           # Your 12-digit AWS account ID

# Bedrock Models
PRIMARY_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
SECONDARY_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
VISION_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 — must be globally unique, use your account ID as suffix
S3_BUCKET_NAME=knowledge-assistant-docs-REPLACE_WITH_ACCOUNT_ID

# Knowledge Base — filled automatically by scripts/setup_knowledge_base.py
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_ARN=

# OpenSearch — filled automatically by scripts/setup_knowledge_base.py or Terraform
OPENSEARCH_COLLECTION_ARN=

# Guardrail — filled automatically by guardrails/setup_guardrail.py (Phase 2)
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# LangFuse observability — filled in Phase 5
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Bonus: Self-hosted TinyLlama on Amazon EKS (Phase 6/7)
TINYLLAMA_ENDPOINT=http://localhost:8080
TINYLLAMA_TIMEOUT=60
